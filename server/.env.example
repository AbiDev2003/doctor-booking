DATABASE_URL="postgresql://doctor_booking:password@localhost:5432/doctor_booking?schema=public"
PORT=3000
CLIENT_URL=http://localhost:5173
# Bootstraps the Clinic.timezone row at seed time. The DB row — NOT this var —
# is the runtime authority for every wall-clock conversion since Day 15 (§3.2):
# the slot generator and the doctor queue read Clinic.timezone. Must be a valid
# IANA zone; the config refuses an unknown one at boot.
APP_TIMEZONE=Asia/Kolkata

JWT_ACCESS_SECRET="replace-with-48-byte-hex"
# No JWT_REFRESH_SECRET: the refresh token is an opaque random string stored as
# SHA-256 so it can be revoked, not a signed token. Nothing verifies it but that
# hash lookup, so there is no second secret to keep.
ACCESS_TOKEN_TTL=15m

# §6.2: password-reset link / OTP lifetime — "short (default: 15 minutes,
# configurable)". Also the lifetime of an email-change verification token
# (§6.1), since both are the same single-use AuthToken row. A blank line means
# the 15-minute default, not "never expires": the duration pattern is required
# and the default is the plan's number.
PASSWORD_RESET_TTL=15m

# §5.1: invitation-claim link lifetime (Day 12). Deliberately its own knob, not
# a reuse of PASSWORD_RESET_TTL: a reset is an emergency (minutes), an invite is
# "whenever you get to it" (a day). Same single-use, hashed, rate-limited token
# mechanic — only the lifetime differs. Blank means the 24h default.
ACCOUNT_CLAIM_TTL=24h

# Rate limiting / lockout (Day 9, §6.3).
#
# Every value below is OPTIONAL. Unset means the §6.3 default shown, so
# production runs on the spec'd policy and this file is only a place to tune
# locally. Nothing here can be set to 0: the config rejects it, because
# `LOCKOUT_FAILURES=0` reads like "lock out on the first mistake" and is
# actually "the threshold is never reached" — the lockout silently off.
#
# Identity key (the submitted email) — the primary defence, and the only one that
# protects a single account. 5 failures inside a 15-minute window locks it, and
# each successive lockout doubles the window up to the 60-minute cap
# (15 -> 30 -> 60). A successful login breaks the run of failures.
LOCKOUT_FAILURES=5
LOCKOUT_WINDOW=15m
LOCKOUT_MAX_WINDOW=60m

# IP key — the secondary cap against sweeping many addresses from one host, and
# against OTP email-bombing. Counts EVERY attempt, successful or not, because
# the threat is volume rather than guessing.
#
# These two apply to all three gates (login, OTP send, OTP verify), each with its
# own budget: `IP_ATTEMPTS_PER_WINDOW` requests per minute per IP *per purpose*, so
# a login flood and an OTP-guessing flood cannot spend each other's allowance. The
# OTP verify term is what actually bounds brute force — the per-token cap alone
# cannot, since each wrong code would hash to a fresh key with a fresh budget.
IP_ATTEMPTS_PER_WINDOW=20
IP_WINDOW=1m

# OTP limits are stricter than the login pair by design: ≤3 sends per 15 minutes
# per address (email-bombing), and ≤5 verification tries per token (replay of a
# valid token). The per-token cap is a TOTAL budget, not a sliding window — the one
# legitimate submission spends one of the five.
OTP_SEND_LIMIT=3
OTP_SEND_WINDOW=15m
OTP_VERIFY_LIMIT=5

# Seed inputs (Day 6). CLINIC_OWNER_EMAIL is the address the first admin is
# created against — §5.1 reads it from the environment, never from a fixture
# literal. CLINIC_OWNER_NAME is that user's `fullName`, which is required on
# User (§24), so set both or neither: the config refuses a name without an email
# rather than letting the seed fail later on the NOT NULL constraint.
# SEED_PATIENT_PASSWORD is for the two seeded *patient* accounts only:
# the seeded admin/doctor/staff rows are created with passwordHash = null and
# claim their password through the §6.2 reset link, so there is deliberately no
# seeded staff password and no dev-only password path.
CLINIC_OWNER_EMAIL="owner@example.com"
CLINIC_OWNER_NAME="Clinic Owner"
SEED_PATIENT_PASSWORD="change-me-locally-only"

# Optional until the phase that needs them (Phase 6 payments, Phase 7 notifications).
RESEND_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
