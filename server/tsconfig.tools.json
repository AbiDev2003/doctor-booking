{
  // Build-time-only TypeScript: the Prisma CLI config and the operational
  // scripts, all of which live outside src/ so the main tsconfig (rootDir
  // ./src, emitting to dist/) ignores them. Checked with --noEmit because
  // none of these files are bundled or shipped.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["prisma.config.ts", "scripts/**/*.ts"]
}
